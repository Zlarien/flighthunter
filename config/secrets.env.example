# =========================================================================
#  Copiez ce fichier en "secrets.env" et remplissez ce que vous possédez.
#  TOUT est optionnel : sans clé, l'app tourne en MODE DEMO (données simulées).
# =========================================================================

# --- Sources de prix ---
TRAVELPAYOUTS_TOKEN=
DUFFEL_TOKEN=
SCRAPFLY_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- IA (Phase 4) ---
ANTHROPIC_API_KEY=

# --- Alertes e-mail (SMTP) ---
# Gmail : créez un "mot de passe d'application" (pas votre mot de passe normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Alertes Telegram ---
# 1) parlez à @BotFather -> /newbot -> récupérez le token
# 2) parlez à votre bot, puis récupérez votre chat_id (ex. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
